OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_SEARCH_MODE=always

HYPERLIQUID_NETWORK=mainnet
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=
ENABLE_LIVE_TRADING=false
ALLOW_PYRAMIDING=false
HYPERLIQUID_SLIPPAGE=0.01

TRADE_SYMBOL=BTC
MAX_NOTIONAL_USD=300

EVENTS_JSONL_PATH=data/free_sources_watch/events.jsonl
RECENT_EVENT_LIMIT=20

MANUAL_STRATEGY_QUERY=如果你是一名激进但有纪律的交易员，你现在会怎么交易BTC？不要预设写死策略。请直接给出你此刻的主观看法，并把只有在价格真正走到关键位附近之后才开始观察和计时的逻辑也说清楚。
ENABLE_PLAYBOOK_MONITOR=true
PLAYBOOK_POLL_SECONDS=5
PRICE_HISTORY_SECONDS=1800
