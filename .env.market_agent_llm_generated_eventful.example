OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_SEARCH_MODE=always

HYPERLIQUID_NETWORK=mainnet
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=
ENABLE_LIVE_TRADING=false
ALLOW_PYRAMIDING=false
HYPERLIQUID_SLIPPAGE=0.01

TRADE_SYMBOL=BTC
MAX_NOTIONAL_USD=300

EVENTS_JSONL_PATH=data/free_sources_watch/events.jsonl
RECENT_EVENT_LIMIT=20

MANUAL_STRATEGY_QUERY=如果你是一名激进但有纪律的交易员，你现在会怎么交易{symbol}？不要预设写死策略。请直接给出你此刻的主观看法，并把只有在价格真正走到关键位附近之后才开始观察和计时的逻辑也说清楚。无论是立即执行还是条件触发执行，都请给出明确的止盈价、止损价、持仓时长，以及失效条件。如果我已经有持仓，请基于我当前真实仓位和账户其他仓位重新给出策略，而不是忽略它们。
ENABLE_PLAYBOOK_MONITOR=true
PLAYBOOK_POLL_SECONDS=5
PRICE_HISTORY_SECONDS=1800
ENABLE_SOFTWARE_RISK_MONITOR=true
RISK_POLL_SECONDS=2
STOP_MONITOR_AFTER_TRADE=true

ENABLE_AUTO_REQUERY=true
LLM_QUERY_INTERVAL_SECONDS=180
FAST_REPLAN_DELAY_SECONDS=2
POSITION_SIZE_CHANGE_TOL=0.00000001
ENABLE_EVENT_DRIVEN_REQUERY=true
IDLE_REQUERY_CHECK_SECONDS=1
