# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_SEARCH_MODE=hybrid
FAST_CONFIDENCE_THRESHOLD=0.72

# Watcher input
WATCH_EVENTS_PATH=data/free_sources_watch/events.jsonl
START_FROM=end

# Hyperliquid account
HYPERLIQUID_NETWORK=mainnet
HL_ACCOUNT_ADDRESS=0xYOUR_MAIN_ACCOUNT_ADDRESS
TRADE_SYMBOL=ETH
MAX_NOTIONAL_USD=300
ALLOW_PYRAMIDING=false

# Safety first: keep false until dry-run looks right
ENABLE_LIVE_TRADING=false
HYPERLIQUID_SLIPPAGE=0.01

# Required only when ENABLE_LIVE_TRADING=true
HL_SECRET_KEY=
