OPENAI_API_KEY=
OPENAI_ACTIVE_MODEL=gpt-5.4
OPENAI_PASSIVE_MODEL=gpt-5.4
OPENAI_ACTIVE_REASONING_EFFORT=high
OPENAI_PASSIVE_REASONING_EFFORT=medium
OPENAI_ACTIVE_REQUEST_TIMEOUT_SECONDS=180
OPENAI_PASSIVE_REQUEST_TIMEOUT_SECONDS=60
ENTRY_EXECUTE_NOW_CONFIDENCE_THRESHOLD=0.70
OPENAI_SEARCH_MODE=always
OPENAI_INCLUDE_CHART_IMAGES=true
OPENAI_INCLUDE_PASSIVE_CHART_IMAGES=false
OPENAI_ACTIVE_CHART_IMAGE_TIMEFRAMES=1m,5m,15m
OPENAI_PASSIVE_CHART_IMAGE_TIMEFRAMES=1m

HYPERLIQUID_NETWORK=mainnet
HL_ACCOUNT_ADDRESS=
HL_USER_FILLS_ADDRESS=
HL_SECRET_KEY=
ENABLE_LIVE_TRADING=false
ENABLE_HYPERLIQUID_USER_FILLS_WEBSOCKET=true
HYPERLIQUID_USER_FILLS_RECONCILE_GRACE_SECONDS=3
ALLOW_PYRAMIDING=false
HYPERLIQUID_SLIPPAGE=0.01
AUTO_CLAMP_MARGIN_DRIFT_RATIO=0.02

TRADE_SYMBOL=BTC

EVENTS_JSONL_PATH=data/free_sources_watch/events.jsonl
RECENT_EVENT_MAX_ITEMS=20
PASSIVE_RECENT_MATERIALLY_NEW_EVENT_LIMIT=0
START_FROM=end

MANUAL_STRATEGY_QUERY=如果你是一名激进但有纪律的交易员，你现在会怎么交易{symbol}？不要预设写死策略。请直接给出你此刻的主观看法，并把只有在价格真正走到关键位附近之后才开始观察和计时的逻辑也说清楚。无论是立即执行还是条件触发执行，都请给出明确的止盈价、止损价、持仓时长，以及失效条件。所有止盈、止损和分批退出都应按标的价格点位或价格条件表达。

ENABLE_PLAYBOOK_MONITOR=true
PLAYBOOK_POLL_SECONDS=5
PRICE_HISTORY_SECONDS=1800
RISK_POLL_SECONDS=2
POSITION_SIZE_CHANGE_TOL=0.00000001
RISK_SOFT_STOP_ENABLED=true
RISK_SOFT_STOP_CONFIRM_TIMEFRAME=1m
RISK_SOFT_STOP_MIN_BUFFER_USD=0.05
RISK_SOFT_STOP_ATR_MULTIPLE=0.10
RISK_SOFT_STOP_R_MULTIPLE=0.05
RISK_TIME_DECAY_NORMAL_TP1_BARS=6
MAIN_LOOP_SLEEP_SECONDS=1
FAST_REPLAN_DELAY_SECONDS=2
REQUERY_ON_PLAYBOOK_END=true

# 主动 query：按固定间隔刷新，但只有在“未进入观察计时、且未持仓风险管理”时才会刷新
ENABLE_ACTIVE_QUERY=true
ENABLE_ACTIVE_AUTO_REQUERY=true
HELPER_RESET_TIME=02:00
ACTIVE_QUERY_INTERVAL_SECONDS=180

# 被动 query：events.jsonl 有新事件时立刻触发一次新 query
ENABLE_PASSIVE_EVENT_QUERY=false
MAX_PLANNED_LOSS_RATIO=0.33
