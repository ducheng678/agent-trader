# Deployment-owned values. Never commit real credentials.
MARKET_AGENT_ENVIRONMENT=production
MARKET_AGENT_API_HOST=0.0.0.0
MARKET_AGENT_API_TOKEN=replace-with-api-token
MARKET_AGENT_REDIS_URL=redis://redis.internal:6379/0
MARKET_AGENT_POSTGRES_DSN=postgresql://market_agent@postgres.internal/market_agent
MARKET_AGENT_HARNESS_HOST_FACTORY=deployment.harness:build_bindings
MARKET_AGENT_ADMIN_CAPABILITY_SECRET=replace-with-at-least-32-byte-secret
MARKET_AGENT_LOCAL_KNOWLEDGE_PATH=config/local_knowledge.jsonl
OPENAI_API_KEY=provided-by-secret-manager
