# ---- Truth Social ----
TRUTHSOCIAL_TOKEN=
TRUTHSOCIAL_HANDLES=realDonaldTrump
# Backward-compatible single handle
# TRUTHSOCIAL_HANDLE=realDonaldTrump
# Optional: only set if Truth Social also requires browser cookies in your environment.
TRUTHSOCIAL_COOKIE_HEADER=
TRUTH_POLL_SECONDS=3
TRUTH_MEDIA_DIR=data/free_sources_watch/truth_media
TRUTH_MEDIA_TIMEOUT=30
# Cookie capture shortcut:
# 1. Open the site in your normal browser.
# 2. Press F12 -> Network -> refresh.
# 3. Click the main document or API request to that site.
# 4. Copy the full request header value after "Cookie:" into the matching *_COOKIE_HEADER env var.

# ---- Other sources: comma-separated multi-instance config ----
WHITEHOUSE_URLS=https://www.whitehouse.gov/news/
AAA_URLS=https://gasprices.aaa.com/
ADP_URLS=https://adpemploymentreport.com/
FED_FEEDS=https://www.federalreserve.gov/feeds/press_all.xml
SEC_FEEDS=https://www.sec.gov/news/pressreleases.rss
DOL_URLS=https://www.dol.gov/newsroom/releases
DOL_COOKIE_HEADER=
BLS_FEEDS=https://www.bls.gov/feed/bls_latest.rss
BLS_COOKIE_HEADER=
CENSUS_RETAIL_URLS=https://www.census.gov/retail/sales.html
TREASURY_URLS=https://home.treasury.gov/news/press-releases
CONFERENCE_BOARD_URLS=https://www.conference-board.org/press/
COINDESK_URLS=https://www.coindesk.com/latest-crypto-news
COINDESK_429_COOLDOWN_SECONDS=900
COINDESK_429_COOLDOWN_MAX_SECONDS=21600
AXIOS_URLS=https://www.axios.com/world/iran
AXIOS_KEYWORDS=iran,trump
FACTBASE_URLS=https://rollcall.com/factbase/trump/topic/calendar/
MNI_URLS=https://www.mnimarkets.com/
IRNA_URLS=https://en.irna.ir/
# Optional official fallback when en.irna.ir is challenge-protected.
IRNA_TELEGRAM_URL=https://t.me/s/Irna_en
# Optional: only needed if both the site and Telegram fallback are blocked in your environment.
IRNA_COOKIE_HEADER=
BLOOMBERG_URLS=https://www.bloomberg.com/markets/economics
# Bloomberg watcher polls the official news sitemap and uses this URL only to derive topic keywords.
BLOOMBERG_SITEMAP_URL=https://www.bloomberg.com/sitemaps/news/latest.xml
# Optional: override topic filtering, e.g. BLOOMBERG_KEYWORDS=inflation,jobs,tariff,fed,dollar
BLOOMBERG_KEYWORDS=trump
# Optional cookie fallback; the sitemap path normally should not need this.
BLOOMBERG_COOKIE_HEADER=
REUTERS_URLS=https://www.reuters.com/markets/
# Reuters watcher polls the official Reuters news sitemap index and uses this URL only to derive topic keywords.
REUTERS_SITEMAP_INDEX_URL=https://www.reuters.com/arc/outboundfeeds/news-sitemap-index/?outputType=xml
# Optional: number of sitemap pages to expand from the index each poll.
REUTERS_SITEMAP_PAGES=3
# Optional: override topic filtering, e.g. REUTERS_KEYWORDS=bitcoin,oil,silver,dxy,treasury
REUTERS_KEYWORDS=trump
WSJ_URLS=https://www.wsj.com/economy
# WSJ watcher polls these official public RSS feeds instead of scraping wsj.com article pages.
WSJ_FEEDS=https://feeds.content.dowjones.io/public/rss/socialeconomyfeed,https://feeds.a.dj.com/rss/WSJcomUSBusiness.xml,https://feeds.a.dj.com/rss/RSSMarketsMain.xml
# Optional: quote values when any keyword contains spaces, e.g. "retail sales" or "dollar index".
# Example below is tuned for BTC / oil / silver + macro catalysts.
WSJ_KEYWORDS="franklin templeton,coinfund,spinoff,bitcoin,adp,payroll,retail sales,dxy,dollar index,treasury,oil,silver,trump"
# As of March 31, 2026, https://www.president.ir/ and https://www.president.ir/en/
# were serving a "coming soon" placeholder rather than a usable news listing page.
# As of March 31, 2026, DOL and BLS were also challenge-protected from this environment.
# If they return challenge/denied pages, capture the browser Cookie header and place it in
# TRUTHSOCIAL_COOKIE_HEADER / IRNA_COOKIE_HEADER / BLOOMBERG_COOKIE_HEADER / DOL_COOKIE_HEADER / BLS_COOKIE_HEADER.

# ---- Common polling/output ----
WEB_POLL_SECONDS=60
WATCH_POLL_TIMEOUT_SECONDS=30
DOL_POLL_TIMEOUT_SECONDS=90
WATCH_MAX_POLL_WORKERS=0
WATCH_WARMUP_MODE=emit_recent
WATCH_OUTPUT_DIR=data/free_sources_watch
WATCH_REQUEST_TIMEOUT=30
WARMUP_PREVIEW_COUNT=3
MAX_SEEN_PER_SOURCE=5000
WATCH_USER_AGENT=Mozilla/5.0
HTTP_RETRY_COUNT=3
HTTP_RETRY_BACKOFF_SECONDS=2

# Warmup modes:
# - emit_recent: emit current items once during startup if they are not already in events.jsonl, then mark them seen
# - mark_seen: mark current items as seen and start from "now"
# - cursor_only: only advance cursor-backed sources; non-cursor sources fall back to mark_seen
